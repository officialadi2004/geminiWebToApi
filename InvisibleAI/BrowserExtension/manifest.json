{
  "manifest_version": 3,
  "name": "Invisible AI Assistant",
  "version": "2.0.0",
  "minimum_chrome_version": "116",
  "description": "Copy a question, press Ctrl+Shift+V, and see a tiny answer inside your current page.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "clipboardRead",
    "offscreen"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "options_page": "src/settings/index.html",
  "commands": {
    "ask-clipboard": {
      "suggested_key": {
        "default": "Ctrl+Shift+V"
      },
      "description": "Answer the copied question"
    },
    "hide-answer": {
      "suggested_key": {
        "default": "Ctrl+Shift+H"
      },
      "description": "Hide the answer"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/overlay.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
